            },
            {
              "width": 256,
              "height": 144,
              "bitrate": "300k",
              "codec": "h264_nvenc"
            }
          ],
          "segmentDuration": 4,
          "targetLatency": "low",
          "gpuProfile": "any blackwell >= 8GB"
        },
        "creator4kav1": {
          "name": "creator4kav1",
          "description": "creator 4k av1 hdr10 10bit nvenc p7 quality + svt-av1 fallback",
          "hardwareAnchor": "rtx 5090",
          "vcpusRequired": 32,
          "ramMbRequired": 65536,
          "vramMbRequired": 23552,
          "ffmpegCmdFragment": "-hwaccel cuda -hwaccel_output_format cuda -i {input} -c:v av1_nvenc -preset p7 -tune hq -rc vbr_hq -cq 28 -b:v 12M -maxrate 15M -profile:v main -pix_fmt p010le -multipass fullres -2pass 1 -g 120 -colorspace bt2020nc -color_trc smpte2084 -color_primaries bt2020 -c:a libopus -b:a 160k",
          "codecPrimary": "av1_nvenc",
          "codecFallback": "libsvtav1",
          "resolution": "3840x2160",
          "fps": [
            24,
            30,
            60
          ],
          "hdr": "hdr10",
          "tenBit": true,
          "bframesEnabled": true,
          "gpuRequired": "rtx5090 0.5 share",
          "vmafTarget": 93,
          "pipelineMemory": "pipelinememorypassage.ts",
          "referenceBoard": "boards.json rtx5090 entry"
        },
        "film8kmezzanine": {
          "name": "film8kmezzanine",
          "description": "film8k mezzanine 8192x4320 prores/vvc archive tier on pro 6000 96GB",
          "hardwareAnchor": "rtx pro 6000 workstation 96GB",
          "vcpusRequired": 96,
          "ramMbRequired": 196608,
          "vramMbRequired": 98304,
          "ramMinFor8k": 98304,
          "vramOptimal": 98304,
          "ffmpegCmdFragmentPrimary": "-hwaccel cuda -i {input} -c:v hevc_nvenc -preset p7 -rc constqp -qp 18 -profile:v main10 -pix_fmt p010le -g 1 -c:a pcm_s24le",
          "ffmpegCmdFragmentVvc": "-i {input} -c:v libvvenc -preset medium -qp 22 -tier high -profile main_10 -g 32 -vvenc_params highbitrate",
          "codecPrimary": "hevc_nvenc",
          "codecMezzanine": "prores_ks",
          "codecFuture": "libvvenc",
          "resolution": "8192x4320",
          "fps": 24,
          "colorspace": "bt2020nc",
          "pixFmtMezzanine": "yuv444p12le",
          "storageTier": "mezzanine",
          "gpuRequired": "pro6000 full or pro6000 96GB unified memory",
          "temporalIsolation": true,
          "maxConcurrentJobs": 1,
          "note": "observer enforces dedicated node when vram > 96GB to avoid time-slice jitter"
