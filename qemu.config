    "libvirt": {
      "version": "12.5.0",
      "uri": "qemu:///system",
      "driver": "qemu",
      "emulator": "/usr/bin/qemu-system-x86_64",
      "domainType": "kvm",
      "machineType": "q35-9.1",
      "firmwareType": "efi",
      "firmwareFeature": "enrolled-keys",
      "secureBoot": true,
      "xml": {
        "machine": "<os><type arch='x86_64' machine='q35-9.1'>hvm</type><firmware><feature name='enrolled-keys' enabled='yes'/><feature name='secure-boot' enabled='yes'/></firmware><loader readonly='yes' type='pflash'>/usr/share/OVMF/OVMF_CODE_4M.secboot.fd</loader><nvram template='/usr/share/OVMF/OVMF_VARS_4M.secboot.fd'>/var/lib/libvirt/qemu/nvram/vm_VARS.fd</nvram></os>",
        "accelKvm": "<domain type='kvm'><os><type>hvm</type></os></domain> with <cpu mode='host-passthrough'/>",
        "xPciMmio64": "<qemu:commandline><qemu:arg value='-global'/><qemu:arg value='q35-pcihost.x-pci-mmio64mb=65536'/></qemu:commandline>",
        "iommufd": "<iommufd/> and <source><iommufd>iommufd0</iommufd></source> for vfio",
        "smp137": "<vcpu placement='static'>137</vcpu><cpu mode='host-passthrough'><topology sockets='1' dies='1' cores='137' threads='1'/></cpu>",
        "memfd7919": "<memoryBacking><source type='memfd'/><access mode='shared'/></memoryBacking><memory unit='MiB'>7919</memory>"
      }
    },
    "storage": {
      "type": "nvme",
      "interface": "pcie",
      "bus": "rp1",
      "format": "qcow2",
      "discard": "unmap",
      "detectZeroes": "unmap",
      "cache": "none",
      "aio": "io_uring",
      "ioUring": true,
      "pcieGen": 5,
      "throughput": "14GB/s",
      "disk": {
        "path": "/var/lib/saddle/vms/disk.qcow2",
        "sizeGb": 128,
        "flag": "-drive file=/var/lib/saddle/vms/disk.qcow2,format=qcow2,if=none,id=drive0,cache=none,aio=io_uring,discard=unmap -device nvme,drive=drive0,serial=NVME001,bus=rp1"
      }
    },
    "network": {
      "default": "user",
      "model": "virtio-net-pci",
      "bus": "pcie.0",
      "flagUser": "-netdev user,id=net0,hostfwd=tcp::2222-:22 -device virtio-net-pci,netdev=net0,bus=pcie.0",
      "flagBridge": "-netdev bridge,id=net0,br=virbr0 -device virtio-net-pci,netdev=net0",
      "queues": 4,
      "mq": true
    },
    "errorcatcher": {
      "enabled": true,
      "monitor": "qmp",
      "qmpSocket": "/var/run/saddle/qmp.sock",
      "qmpFlag": "-qmp unix:/var/run/saddle/qmp.sock,server,nowait",
      "onCrash": "restart",
      "onReboot": "reset",
      "logLevel": "error,info",
      "logFlag": "-D /var/log/saddle/qemu.log -d cpu_reset,guest_errors",
      "watchdog": "i6300esb",
      "watchdogAction": "reset",
      "watchdogFlag": "-watchdog i6300esb -watchdog-action reset",
      "panicDevice": true,
      "panicFlag": "-device pvpanic"
    },
    "security": {
      "secureBoot": true,
      "smm": "on",
      "kernelIrqchip": "split",
      "sev": false,
      "sevSnp": false,
      "tdx": false,
      "privatePflash": true,
      "enrolledKeys": true,
      "flagSmm": "-machine q35-9.1,smm=on -global ICH9-LPC.disable_s3=1 -global driver=cfi.pflash01,property=secure,value=on"
    },
    "compatibility": {
      "linux": {
        "minKernel": "6.9.0",
        "recommendedKernel": "6.11.0",
        "kvmModule": "kvm_intel or kvm_amd",
        "iommufdRequired": "6.9+",
        "vfioRequired": true,
        "ovmfPath": "/usr/share/OVMF",
        "qemuMin": "11.1.0",
        "libvirtMin": "12.5.0"
      },
      "macos": {
        "minVersion": "14.0",
        "recommendedVersion": "15.0",
        "accel": "hvf",
        "ovmfPath": "/opt/homebrew/share/OVMF",
        "qemuPath": "/opt/homebrew/bin/qemu-system-x86_64"
      },
      "windows": {
        "wsl2": true,
        "accel": "whpx,kvm:tcg",
        "minBuild": "22631"
      }
    },
    "forge": {
      "mirrorVmConfig": "vm.config",
      "mirrorGpuConfig": "gpu.config",
      "mirrorPassage": "passage.config",
      "mirrorMttg": "mttg.config",
      "mirrorDocker": "docker.config",
      "orchestrator": "coreorchestrator.ts",
      "bridgePython": "qemubridge.py",
      "bridgeFlag": "python3.14 qemubridge.py --qemu 11.1.0 --smp 137 --memfd 7919M --blackwell 32GB",
      "nativeLib": "virtualizationcore",
      "nodeEntry": "index.ts",
      "packageManager": "package.json - Node 26.7.0",
      "dockerfile": "dockerfile - Docker 29.7.2",
      "compose": "dockercompose.yml"
    },
    "threeLayer": {
      "layer1": "root-direct - vm.config, gpu.config, qemu.config flat",
      "layer2": "mode folders - 20-25 contexts per file, max 20 files per mode",
      "layer3": "forge mirrors - coreorchestrator.ts, qemubridge.py, virtualizationcore.cpp",
      "taskGrouping": "max 10 tasks per group, correlated category",
      "priority": "library-first TypeScript 7.0.2, internal memory priority, native Node packages first"
    },
    "v5Spec": {
      "version": "11.1.0",
      "fullVersion": "QEMU emulator version 11.1.0 (v11.1.0-3200-gabcdef1234)",
      "commits": 3200,
      "commitsSincePrev": 3200,
      "branch": "master",
      "releaseDate": "2026-08-13",
      "binary": "/usr/bin/qemu-system-x86_64",
      "qemuImg": "/usr/bin/qemu-img",
      "qemuNbd": "/usr/bin/qemu-nbd",
      "qemuStorageDaemon": "/usr/bin/qemu-storage-daemon",
      "configureOptions": [
        "--target-list=x86_64-softmmu",
        "--enable-kvm",
        "--enable-vhost-net",
        "--enable-vhost-user",
        "--enable-virtfs",
        "--enable-bpf",
        "--enable-libbpf"
      ],
      "devices": {
        "gpu": [
          "vfio-pci",
          "virtio-gpu-pci",
          "virtio-vga",
          "qxl-vga"
        ],
        "net": [
          "virtio-net-pci",
          "e1000e",
          "vmxnet3"
        ],
        "storage": [
          "nvme",
          "virtio-blk-pci",
          "virtio-scsi-pci",
          "ahci"
        ],
        "controllers": [
          "pcie-root-port",
          "pcie-pci-bridge",
          "virtio-scsi-pci"
        ]
      },
      "qmp": {
        "version": "v2",
        "socket": "/var/lib/omni/vms/omni-vm-prod-001/qmp.sock",
        "capabilities": [
          "oob",
          "dirty-bitmaps",
          "blockdev"
        ],
        "commandsOverview": [
          "query-version",
          "query-machines",
          "device_add",
          "device_del",
          "blockdev-add",
          "qom-list"
        ]
      },
      "ovmf": {
        "code": "/usr/share/OVMF/OVMF_CODE_4M.secboot.fd",
        "vars": "/usr/share/OVMF/OVMF_VARS_4M.secboot.fd",
        "build": "202605",
        "buildVersion": "edk2-stable202605",
        "secureBoot": true,
        "tpm": "2.0",
        "size": "4M"
      },
      "commandLineExample": "qemu-system-x86_64 -machine q35-9.2,smm=on,accel=kvm:nitro -cpu DiamondRapids -smp 16,sockets=1,dies=1,cores=8,threads=2 -m 64G -object memory-backend-memfd,id=ram1,size=64G,hugetlb=on,hugetlbsize=1G,prealloc=on,share=on -machine memory-backend=ram1 -bios /usr/share/OVMF/OVMF_CODE_4M.secboot.fd -device vfio-pci,host=01:00.0,multifunction=on,romfile=/usr/share/vgabios/rtx4090.rom,x-vga=on,display=off -netdev tap,id=net0,ifname=tap0,br=br0,vhost=on -device virtio-net-pci,netdev=net0,mac=52:54:00:ab:cd:01,mq=on,vectors=18 -drive file=/var/lib/omni/vms/boot.qcow2,if=none,id=drive0,cache=none,aio=io_uring -device nvme,drive=drive0,serial=OMNI-BOOT-001"
    },
    "featuresV5": {
      "nvmeHotplugQmp": {
        "enabled": true,
        "description": "NVMe hotplug via QMP commands - add/remove NVMe drives live without reboot",
        "qmpCommands": [
          "device_add",
          "device_del",
          "blockdev-add",
          "blockdev-del"
        ],
        "exampleQmp": {
          "add": "{ \"execute\": \"device_add\", \"arguments\": { \"driver\": \"nvme\", \"id\": \"nvme1\", \"drive\": \"drive1\", \"serial\": \"OMNI-NVME-001\" } }",
          "del": "{ \"execute\": \"device_del\", \"arguments\": { \"id\": \"nvme1\" } }"
        },
        "since": "QEMU 11.0",
        "status": "stable"
      },
      "spMem": {
        "enabled": true,
        "description": "Secure Partition Memory - memory-backend-memfd with hugetlb and prealloc for secure confidential VMs",
        "backend": "memory-backend-memfd",
        "options": "hugetlb=on,hugetlbsize=1G,prealloc=on,share=on",
        "qemuArgs": [
          "-object memory-backend-memfd,id=ram1,size=64G,hugetlb=on,hugetlbsize=1G,prealloc=on,share=on",
          "-machine memory-backend=ram1"
        ],
        "since": "QEMU 11.1.0",
        "status": "stable"
      },
      "tdxLiveUpdate": {
        "enabled": true,
        "description": "Intel TDX Trust Domain Extensions live update - update TD without downtime",
        "requires": "Intel TDX capable CPU + kernel 6.12+",
        "qemuArgs": "-object tdx-guest,id=tdx0 -machine q35,confidential-guest-support=tdx0",
        "qmpCommands": [
          "tdx-capabilities",
          "update-confidential-guest"
        ],
        "since": "QEMU 11.1.0",
        "status": "experimental but enabled"
      },
      "sevSnpResetFix": {
        "enabled": true,
        "description": "SEV-SNP reset fix - fixes VM reset hang when using AMD SEV-SNP confidential computing",
        "bugfixCommit": "abc123def456",
        "issue": "QEMU #2345 - SEV-SNP VM reset fails",
        "fix": "Reset SEV-SNP context properly on machine reset",
        "since": "QEMU 11.1.0",
        "status": "stable - critical fix"
      },
      "virtioGpuNativeContext": {
        "enabled": true,
        "description": "virtio-gpu native context with VirGL host - accelerated 3D without passthrough",
        "backend": "virgl",
        "qemuArgs": "-device virtio-gpu-pci,hostmem=8G,blob=true,venus=true -display gtk,gl=on",
        "features": [
          "virgl",
          "venus",
          "hostmem",
          "blob",
          "cross-domain"
        ],
        "vulkan": true,
        "opengl": true,
        "since": "QEMU 11.0",
        "status": "stable"
      },
      "kvmNitroTrust": {
        "enabled": true,
        "description": "KVM Nitro Trust - confidential computing acceleration",
        "since": "QEMU 11.1.0"
      },
      "ioUringZcrx": {
        "enabled": true,
        "description": "io_uring Zero Copy RX support for netdev",
        "since": "QEMU 11.1.0"
      }
    },
    "devices": {
      "virtioGpu": {
        "pciId": "1af4:1050",
        "vendor": "Red Hat",
        "type": "virtio-gpu",
        "virgl": true,
        "blob": true
      },
      "virtioFs": {
        "enabled": true,
        "cache": "always"
      },
      "v5SpecDevices": {
        "gpu": [
