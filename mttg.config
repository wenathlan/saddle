          "vcpusRequired": 4,
          "ramMbRequired": 2048,
          "vramMbRequired": 2048,
          "ffmpegCmdFragment": "-hwaccel cuda -hwaccel_output_format cuda -i {input} -c:v h264_nvenc -preset p5 -rc vbr_hq -cq 23 -multipass qres -b:v 5M -maxrate 6M -g 48 -c:a aac -b:a 128k -hls_time 4 -hls_playlist_type vod",
