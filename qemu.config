          "memBackendFlag": "-object memory-backend-memfd,id=ram0,size=262144M,share=on -object memory-backend-memfd,id=ram1,size=262144M,share=on -object memory-backend-memfd,id=ram2,size=262144M,share=on -object memory-backend-memfd,id=ram3,size=262144M,share=on -object memory-backend-memfd,id=ram4,size=262144M,share=on -object memory-backend-memfd,id=ram5,size=262144M,share=on -object memory-backend-memfd,id=ram6,size=262144M,share=on -object memory-backend-memfd,id=ram7,size=262144M,share=on",
          "fullCli": "qemu-system-x86_64 -machine q35-9.1,kernel-irqchip=split -accel kvm,thread=multi,dirty-ring-size=65536 -cpu host,migratable=off -smp cpus=1024,sockets=8,dies=2,cores=64,threads=1,maxcpus=1024 -m 2097152 -object memory-backend-memfd,id=ram0,size=262144M,share=on -object memory-backend-memfd,id=ram1,size=262144M,share=on -object memory-backend-memfd,id=ram2,size=262144M,share=on -object memory-backend-memfd,id=ram3,size=262144M,share=on -object memory-backend-memfd,id=ram4,size=262144M,share=on -object memory-backend-memfd,id=ram5,size=262144M,share=on -object memory-backend-memfd,id=ram6,size=262144M,share=on -object memory-backend-memfd,id=ram7,size=262144M,share=on -numa node,nodeid=0,memdev=ram0 -numa node,nodeid=1,memdev=ram1 -numa node,nodeid=2,memdev=ram2 -numa node,nodeid=3,memdev=ram3 -numa node,nodeid=4,memdev=ram4 -numa node,nodeid=5,memdev=ram5 -numa node,nodeid=6,memdev=ram6 -numa node,nodeid=7,memdev=ram7 -drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd -global q35-pcihost.x-pci-mmio64mb=65536 -object iommufd,id=iommufd0 -device pcie-root-port,bus=pcie.0,id=rp1"
        }
      }
    },
