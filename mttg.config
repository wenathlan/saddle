        },
        "cgroupPath": "/sys/fs/cgroup/omni.slice/tenant-bronze",
        "systemdUnit": "omni-tenant-bronze.slice",
        "vmConfigTomlConfirmation": "identical values present in vm.config.toml [vm.mttg.tenants.bronze] - unified here"
      },
      "envelope": {
        "description": "Multi-tenant resource pools gold/silver/bronze with weights and QoS",
        "count": 3,
        "isolation": "cgroup v2 per tenant"
      }
    },
    "qosClasses": {
      "count": 4,
      "description": "4 QoS classes - guaranteed/burstable/besteffort/idle mapped to cpu.weight and policies",
      "classes": [
        {
          "name": "guaranteed",
          "priority": 1,
          "cpuWeight": 10000,
          "cpuWeightNice": -10,
          "cpuGuarantee": "100%",
          "cpuMax": "1600000 100000",
          "description": "Guaranteed QoS: full CPU reservation, no overcommit, high-priority IO, reserved memory",
          "memoryPolicy": "no-overcommit",
          "ioPolicy": "high-priority",
          "ioWeight": 1000,
          "memoryHigh": "60G",
          "memoryMax": "64G",
          "pidsMax": 8192,
          "behavior": "Guaranteed CPU, memory protection, never throttled below guarantee",
          "useCase": "Production critical workloads, databases, latency-sensitive",
          "exampleTenant": "gold",
          "cgroupAnnotations": {
            "cpu.weight": 10000,
            "cpu.max": "1600000 100000",
            "memory.high": "60G",
            "memory.max": "64G",
            "io.weight": 1000,
            "pids.max": 8192,
            "cpu.idle": 0
          }
        },
        {
          "name": "burstable",
          "priority": 2,
          "cpuWeight": 5000,
          "cpuWeightNice": -5,
          "cpuGuarantee": "50%",
          "cpuMax": "800000 100000",
          "description": "Burstable: baseline 50% CPU with burst to 100%, bounded memory overcommit",
          "memoryPolicy": "bounded-overcommit",
          "ioPolicy": "normal",
          "ioWeight": 500,
          "memoryHigh": "30G",
          "memoryMax": "32G",
          "pidsMax": 4096,
          "behavior": "Baseline guarantee plus burst capability via cpu.max burst",
          "useCase": "General production, web services which need burst",
          "exampleTenant": "silver",
          "cgroupAnnotations": {
            "cpu.weight": 5000,
            "cpu.max": "800000 100000 burst 1600000",
            "memory.high": "30G",
            "memory.max": "32G",
            "io.weight": 500,
            "pids.max": 4096
          }
        },
        {
          "name": "besteffort",
          "priority": 3,
          "cpuWeight": 100,
          "cpuWeightNice": 0,
          "cpuGuarantee": "0%",
          "cpuMax": "200000 100000",
          "description": "Best-effort: opportunistic scheduling, full overcommit allowed, lowest guarantee",
          "memoryPolicy": "overcommit",
          "ioPolicy": "low-priority",
          "ioWeight": 100,
          "memoryHigh": "8G",
          "memoryMax": "16G",
          "pidsMax": 1024,
          "behavior": "Only runs when spare capacity exists, first to be reclaimed",
          "useCase": "Batch jobs, dev environments, non-critical",
          "exampleTenant": "bronze",
          "cgroupAnnotations": {
            "cpu.weight": 100,
            "cpu.max": "200000 100000",
            "memory.high": "8G",
            "memory.max": "16G",
            "io.weight": 100,
            "pids.max": 1024
          }
        },
        {
          "name": "idle",
          "priority": 4,
          "cpuWeight": 1,
          "cpuWeightNice": 19,
          "cpuGuarantee": "0%",
          "cpuMax": "50000 100000",
          "description": "Idle: cpu.idle=1, lowest priority, only when system fully idle, first reclaim",
          "memoryPolicy": "reclaim-first",
          "ioPolicy": "idle",
          "ioWeight": 1,
          "memoryHigh": "2G",
          "memoryMax": "4G",
          "pidsMax": 256,
          "behavior": "cpu.idle=1, runs ONLY when no other cgroup wants CPU",
          "useCase": "Background cleanup, idle batch, scavenger workloads",
          "exampleTenant": "idle-pool",
          "cgroupAnnotations": {
            "cpu.weight": 1,
            "cpu.idle": 1,
            "cpu.max": "50000 100000",
            "memory.high": "2G",
            "memory.max": "4G",
            "io.weight": 1,
