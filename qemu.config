    "description": "e2ugh v6 - QEMU Configuration (canonical JSON; sources: S6 TOML + v5 spec 11.1.0 + libvirt overlay)",
    "sources": [
      "pool:qemu.config [S6 TOML, 47 sections - structural base]",
      "pool:qemu.json [V5 spec 11.1.0 - DiamondRapids/AMX/TDX/sp_mem/nitro]",
      "pool:qemu.conf [AetherForge libvirt overlay]",
      "pool:nested_qemu.json [virtio-gpu/virtio-fs/memoverlay/dolos/smi-adapter]"
    ],
    "mergeReport": {
      "s6Sections": 17,
      "v5UniqueFeatures": [
        "nvme_hotplug_qmp",
        "sp_mem",
        "tdx_live_update",
        "sev_snp_reset_fix",
        "virtio_gpu_native_context",
        "kvm_nitro_trust",
        "io_uring_zcrx"
      ],
      "overlayUnique": [
        "cgroup_device_acl 13 devs (vfio, looking-glass shm)",
        "migration port range 49152-49215",
        "max_files 32768",
        "stdio_handler logd"
      ],
      "nestedUnique": [
        "virtio-gpu 1af4:1050 virgl+blob",
        "virtio-fs cache=always",
        "memoverlay LD_PRELOAD",
        "dolos sysinfo() 128GB",
        "smi-adapter H100 81559MiB / A100 40536MiB / RTX5090 32768MiB"
      ],
      "conflictResolution": "qemu 11.1.0 -> 11.1.0; q35-9.1 -> q35-9.2; cpu models unified (EPYC-Turin + EPYC-v5 lineage); MTTCG kept as own section with reference to mttg.config",
