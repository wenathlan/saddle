          "profile": "large",
          "vcpus": 64,
          "ramMb": 65536,
          "fullCli": "qemu-system-x86_64 -machine q35-9.1,kernel-irqchip=split -accel kvm,thread=multi -cpu host -smp cpus=64,sockets=2,cores=32,threads=1 -m 65536 -object memory-backend-memfd,id=ram0,size=65536M,share=on -numa node,nodeid=0,cpus=0-31,memdev=ram0 -numa node,nodeid=1,cpus=32-63,memdev=ram1 -object memory-backend-memfd,id=ram1,size=65536M,share=on -drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd -global q35-pcihost.x-pci-mmio64mb=65536 -object iommufd,id=iommufd0"
        },
        "xlarge": {
          "profile": "xlarge",
          "vcpus": 137,
          "ramMb": 7919,
          "description": "Saddle default - 137 vCPUs with 7919M memfd - matches task requirement",
          "fullCli": "qemu-system-x86_64 -machine q35-9.1,kernel-irqchip=split,smm=on,vmport=off -accel kvm,thread=multi,dirty-ring-size=65536 -cpu host,migratable=off,l3-cache=on -smp cpus=137,sockets=1,dies=1,cores=137,threads=1,maxcpus=1024 -m 7919 -object memory-backend-memfd,id=ram0,size=7919M,share=on,prealloc=off -numa node,nodeid=0,cpus=0-136,memdev=ram0 -drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd -drive if=pflash,format=raw,file=OVMF_VARS.fd -global q35-pcihost.pci-hole64-size=65536 -global q35-pcihost.x-pci-mmio64mb=65536 -device pcie-root-port,bus=pcie.0,id=rp1,port=1,chassis=1,slot=1,bus-reserve=128 -object iommufd,id=iommufd0 -device vfio-pci,host=0000:01:00.0,bus=rp1,addr=0x0,iommufd=iommufd0,x-vga=off,rombar=1 -nographic"
        },
