          "fullCli": "qemu-system-x86_64 -machine q35-9.1,kernel-irqchip=split,smm=on -accel kvm,thread=multi -cpu host -smp cpus=137,cores=137 -m 65536 -object memory-backend-memfd,id=ram0,size=65536M,share=on -numa node,memdev=ram0 -drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd -drive if=pflash,format=raw,file=OVMF_VARS.fd -global q35-pcihost.x-pci-mmio64mb=65536 -device pcie-root-port,bus=pcie.0,id=rp1 -object iommufd,id=iommufd0 -device vfio-pci,host=0000:01:00.0,bus=rp1,iommufd=iommufd0,rombar=1,x-vga=off -device vfio-pci,host=0000:01:00.1,bus=rp1,iommufd=iommufd0"
        },
        "insane": {
          "profile": "insane",
          "vcpus": 1024,
          "ramMb": 2097152,
