  "scripts": {
    "build:engine": "node tests/scripts/buildengine.mjs",
    "check": "npm run build:engine && node --check dist/index.js && node --check dist/execution.js && node --check dist/cli.js && node --check dist/browser.js && node --check dist/distribution.js",
    "formatcheck": "node --import tsx format.ts",
    "test": "npm run build:engine && node --import tsx --test tests/engine.test.ts tests/extension.test.ts tests/package.test.ts tests/release.test.ts tests/virtualengine.test.ts tests/features.test.ts tests/media.test.ts tests/render.test.ts tests/simulation.test.ts tests/specs.test.ts tests/virtualcpu.test.ts tests/virtualgpu.test.ts tests/virtualmemory.test.ts tests/web.test.ts tests/workflow.test.ts",
    "test:legacy": "vitest run tests/agent-utils.test.ts tests/cache.test.ts tests/chunking.test.ts tests/core.test.ts tests/errors.test.ts tests/llms-txt.test.ts tests/middleware.test.ts tests/proxy.test.ts tests/tokens.test.ts",
    "run": "npm run build:engine && node dist/cli.js",
    "extension:build": "npm run build:engine && node dist/browser.js",
    "release:assets": "npm run build:engine && node dist/distribution.js",
    "release:verify": "npm run build:engine && node dist/distribution.js verify",
    "target:manifest": "npm run build:engine && node dist/distribution.js target",
    "pack:check": "npm run check && npm run formatcheck && npm test && npm pack --dry-run",
    "prepublishOnly": "npm run pack:check",
    "tauri": "npx --yes @tauri-apps/cli@2.11.4",
    "capacitor:sync:android": "npm run web:build:pages && cap sync android",
    "capacitor:flatten:android": "node tests/scripts/flattenandroid.mjs",
    "capacitor:sync:ios": "npm run web:build:pages && cap sync ios",
    "native:check:flat": "node tests/scripts/validateflatnative.mjs",
    "web:dev": "vite --config web/vite.config.ts --host",
    "web:check": "npm run build:engine && tsc --project web/tsconfig.json --noEmit",
    "web:build": "vite build --config web/vite.config.ts",
    "web:build:pages": "vite build --config web/vite.config.ts",
    "build": "npm run build:engine",
    "build:tsc": "tsc -p tsconfig.json --noEmitOnError false",
    "start": "node ./index.ts",
    "start:e2ugh": "node ./index.ts --mode vm",
    "dev": "node --watch ./index.ts",
    "web": "node web/sandbox/server.js",
    "qemu:bridge": "node ./orchestrator.ts --qemu-bridge",
    "toolchain:verify": "node --version && npx tsc --version && python3 --version && qemu-system-x86_64 --version || true && docker --version",
    "dev:tsx": "node --watch ./index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "biome lint .",
    "lint:biome": "biome lint --write .",
    "lint:fix": "biome lint --write . && biome check --write .",
    "format": "biome format --write .",
    "format:biome": "biome format --write .",
    "format:check": "biome check .",
    "test:watch": "node --test --watch tests/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage tests/*.test.ts",
    "test:unit": "node --test tests/*.test.ts",
    "test:e2e": "node --test tests/*.test.ts",
    "qemu:version": "qemu-system-x86_64 --version || echo 'qemu 11.1.0 expected 2026-08-22'",
    "vm:create": "node ./index.ts --create-vm",
    "vm:validate": "node ./index.ts --validate-vm",
    "gpu:list": "node ./index.ts --list-gpus",
    "docker:build": "docker build -f Dockerfile -t e2ugh:2.0.0 .",
    "docker:run": "docker run --rm --memory-swap=-1 --shm-size=2g e2ugh:2.0.0",
    "docker:health": "docker run --rm e2ugh:2.0.0 qemu-system-x86_64 --version && curl -fsS http://localhost:8080/health || true",
    "firecracker:boot": "firecracker --api-sock /tmp/fc-e2ugh.sock --config-file vmconfig.json 2>/dev/null || echo 'firecracker 1.16.1 warm-pool boot 125ms target'",
    "py:bridge": "python3 qemubridge.py",
    "py:test": "python3 -m pytest -q || python3 qemubridge.py",
    "clean": "rm -rf dist coverage .biome __pycache__",
    "prepare": "echo 'e2ugh v9 toolchain 2026-08-23: Node 26.7.0 Current / 24.19.0 LTS, npm 12.0.2, TS 7.0.2, Python 3.14.7, Docker 29.7.2, QEMU 11.1.0, Mesa 26.2.1, LLVM 22.1.8, Firecracker 1.16.1'"
  },
