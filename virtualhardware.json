{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "e2ugh",
    "title": "e2ugh v6 - Master Schema, Cross-References and Compatibility Matrix",
    "version": "2.0.0",
    "date": "2026-08-22",
    "language": "en",
    "description": "Master schema of the e2ugh v6 virtual hardware engine: binds the 10 specification files (cpu, cores, boards, gpu, vm.config, passage, docker, qemu, mttcg, mesa), defines the modularity ranges (vCPU 1-192, RAM 1-1024 GB, vRAM 8-96 GB via MIG), defaults, validation rules and the pinned 2026-08-22 compatibility matrix.",
    "sources": [
      "https://nodejs.org/en/blog/release/v26.7.0",
      "https://nodejs.org/en/blog/release/v24.19.0",
      "https://www.npmjs.com/package/typescript",
      "https://docs.docker.com/engine/release-notes/29/",
      "https://docs.mesa3d.org/relnotes/26.2.1.html",
      "https://github.com/llvm/llvm-project/releases",
      "https://www.qemu.org/2026/08/11/qemu-11-1-0/",
      "https://github.com/firecracker-microvm/firecracker/releases",
      "https://github.com/google/gvisor/releases",
      "https://github.com/kata-containers/kata-containers/releases",
      "https://github.com/checkpoint-restore/criu/releases",
      "https://github.com/bytecodealliance/wasmtime/releases",
      "https://www.cloudhypervisor.org",
      "https://github.com/docker/compose/releases",
      "https://github.com/docker/buildx/releases",
      "https://www.npmjs.com/package/@biomejs/biome",
      "https://bun.com/blog",
      "pool:catalog.json [quick_catalog: prices + b200 driver 580.105.08]",
      "pool:versioncatalog.json + nested_version-catalog.json [legacy_catalog, 2025 pins - never override v5]",
      "pool:nested_virtualhardware.json [guest_envelope_schema draft-07, re-pinned]",
      "pool:moduleconfig.json + nested_module-config.json [nbit module modes]"
    ],
    "mergeReport": {
      "modules": 12,
      "quickCatalogCpus": 7,
      "quickCatalogGpus": 4,
      "legacyCatalogPins": {
        "node": "20.19.0",
        "typescript": "5.8.3",
        "mesa": "25.2.7",
        "llvm": "19.1.7",
        "dockerode": "4.0.8",
        "express": "5.1.0",
        "commander": "13.1.0",
        "zod": "4.0.5",
        "ws": "8.18.1"
      },
      "envelopeEnums": {
        "cpu": ["EPYC 9965", "9950X3D", "9950X3D2", "9995WX", "7980X"],
        "gpu": ["RTX5090", "RTXPRO6000"]
      },
      "note": "guest_envelope enums kept as source; full live catalog in processors.json (57) and gpus.json (19)",
      "pinPatch": "embedded active config values re-pinned date-first 2026-08-22 (9.1.2->11.1.0, 27.3.1->29.7.2, 22.12.3->24.19.0, 5.6.3->7.0.2, 25.2.7->26.2.1, 19.1.7->22.1.8, 1.9.0->1.16.1, libvirt 10.10.0->12.5.0, checkout v4.2.2->v5); originals preserved under *_legacy*/source_value keys"
    }
  },
  "engine": {
    "name": "Virtual Hardware Engine",
    "version": "5.0.0",
    "tagline": "100% software virtual hardware: CPU/RAM/GPU identity spoofing + software GL/Vulkan/OpenCL + QEMU microVMs + Docker sandboxes",
    "specDate": "2026-08-22",
    "specFilesCount": 11
  },
  "modules": [
    {
      "file": "cpu.json",
      "purpose": "virtual CPU database (EPYC 9965/9955, Ryzen 9950X3D, Threadripper PRO 9995WX, Threadripper 7980X, Core Ultra 9 285K) with CPUID flags per family, lscpu/proc-cpuinfo virtual identity templates and QEMU cpu models",
      "provides": ["processors[].id", "families[].id", "cpuid_reference", "qemu_cpu_models"]
    },
    {
      "file": "cores.json",
      "purpose": "vCPU modularity presets (1..192), SMT2 mapping, cache topology per model, NUMA NPS1/2/4, affinity masks, QEMU -smp generation",
      "provides": ["vcpu_presets", "cache_topology", "numa", "qemu_topology_generation"]
    },
    {
      "file": "boards.json",
      "purpose": "platform systems SP5/AM5/sTR5(WRX90/TRX50)/LGA1851 with memory population, PCIe lane maps, form factors (ATX/E-ATX/CEZANNE) and QEMU machine mapping",
      "provides": ["boards[].id", "qemu_machine_mapping", "form_factor_reference"]
    },
    {
      "file": "gpu.json",
      "purpose": "virtual GPU database (RTX 5090, RTX PRO 6000 Blackwell, B200, H100, A100, RX 9070 XT, MI350X) with PCI ids, MIG profiles, nvidia-smi format and smi-adapter profiles",
      "provides": [
        "gpus[].id",
        "fake_smi_profiles",
        "mig.profiles_rtx_pro_6000",
        "nvidia_smi_format"
      ]
    },
    {
      "file": "vm.config.json",
      "purpose": "22 orchestrator VM profiles (dev, build, buildfarm, ai, render, gaming, llm, trading, mobile, edge, database, e2e) binding cpu+cores+boards+gpu+runtime",
      "provides": ["profiles[].id", "orchestrator_defaults", "profile_index"]
    },
    {
      "file": "passage.json",
      "purpose": "passthrough matrix: VFIO, MDEV, MIG, vGPU, SR-IOV, vfio-user (Cloud Hypervisor v53 experimental), hotplug, KVM availability ladder with TCG fallback",
      "provides": ["mode_overview", "kvm", "decision_matrix"]
    },
    {
      "file": "docker.json",
      "purpose": "Docker 29.7.2 / Compose 5.5.0 / Buildx 0.36.1: MemorySwap -1, ShmSize 2g, NanoCpus, tmpfs 20G, overcommit, seccomp, gVisor runsc, userns, cap-drop",
      "provides": [
        "container_run_reference",
        "daemon_configuration",
        "runtimes",
        "buildx_reference"
      ]
    },
    {
      "file": "qemu.json",
      "purpose": "QEMU 11.1.0: MTTCG flags, EPYC-v5 model (target/i386/cpu.c), tb-size, q35/microvm, -smp topology, snapshot/savevm + CRIU, no-KVM CI workaround, nitro accelerator",
      "provides": ["accelerators", "cpu_models", "example_commands", "qmp_reference"]
    },
    {
      "file": "mttcg.json",
      "purpose": "MTTCG internals: per-vCPU threads, TranslationBlock cache, lockless QHT, enablement rules, 192-vCPU scaling and performance tuning",
      "provides": ["architecture", "scaling_to_192_vcpus", "recommended_flags_matrix"]
    },
    {
      "file": "mesa.json",
      "purpose": "Mesa 26.2.1 + LLVM 22.1.8 stack: llvmpipe GL 4.6 (161/161), lavapipe Vulkan 1.4, Rusticl OpenCL 3.1, every validated env var, Xvfb :99 recipe",
      "provides": ["versions", "environment_variables", "xvfb", "spoof_recipes"]
    },
    {
      "id": "memory",
      "file": "memory.json",
      "note": "added in v2 (memory.json split from vram/vm.config; virtualhardware self-reference)"
    },
    {
      "id": "virtualhardware",
      "file": "virtualhardware.json",
      "note": "added in v2 (memory.json split from vram/vm.config; virtualhardware self-reference)"
    }
  ],
