{
  "meta": {
    "name": "mttg.config",
    "title": "saddle - MTTG Multi-Tenant Task Groups (cgroups v2 + tenants + transcode) with MTTCG (QEMU TCG) section",
    "version": "2.0.0",
    "date": "2026-08-22",
    "language": "en",
    "conceptSeparation": "MTTG = Multi-Tenant Task Groups (cgroup v2 cpu.weight/cpuset/memory/io/pids/hugetlb/rdma + tenants + transcode pipelines). MTTCG = QEMU Multi-Threaded TCG (one host thread per vCPU under TCG). Both live here as DISTINCT sections; MTTCG accel flags also in qemu.config#mttcg.",
    "sources": [
      "pool:mttg.config [S6 TOML, 28 sections: transcode/nvenc/codecs/pipelines/modes]",
      "pool:mttcg.json [V5 - MTTCG spec: architecture/enablement/scaling_192/tuning/limitations/flags_matrix]",
      "pool:mttg.json [OMNI 20.7KB - cgroups v2 complete: cpu.weight 1-10000/burst/cpuset/memory/io/pids/hugetlb/rdma + systemd omni.slice + tenants + qos_classes]",
      "pool:nested_mttcg.json [tcg-accel-ops-mttcg.c functions + overhead <8%]",
      "pool:vm.config.toml [vm.mttg tenants/qos/scheduler EEVDF+BORE+sched_ext - identical values, unified]"
    ],
    "mergeReport": {
      "s6Sections": 15,
      "modesCount": 5,
      "resourceProfiles": 5,
      "cgroupsControllers": [
        "cpu",
        "cpuset",
        "memory",
        "io",
        "pids",
        "hugetlb",
        "rdma"
      ],
      "tenants": [
        "gold",
        "silver",
        "bronze",
        "_envelope"
      ],
      "qosClasses": [
        "count",
        "description",
        "classes"
      ],
      "schedulers": [
        "EEVDF (default since 6.6; kernel 7.1.9)",
        "BORE-6.12.15",
        "sched_ext-bp-1.2.0"
      ],
      "conflictResolution": "tenants gold/silver/bronze identical in mttg.json and vm.config.toml -> unified once; legacy qemu 11.1.0 pins -> 11.1.0",
      "pinPatch": "embedded active config values re-pinned date-first 2026-08-22 (9.1.2->11.1.0, 27.3.1->29.7.2, 22.12.3->24.19.0, 5.6.3->7.0.2, 25.2.7->26.2.1, 19.1.7->22.1.8, 1.9.0->1.16.1, libvirt 10.10.0->12.5.0, checkout v4.2.2->v5); originals preserved under *_legacy*/source_value keys",
      "v4fix3PipelineSection": {
        "stageCount": 24,
        "policy": "create_optimal scheduling policy only; stage table delegated to media.ts (transcode domain)",
        "skipRules": 5,
        "passageMtu": 65536
      }
    }
  },
  "mttg": {
    "stack": {
