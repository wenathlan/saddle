    "accelerator": {
      "kvm": {
        "enabled": true,
        "type": "kvm",
        "flag": "-accel kvm,thread=multi",
        "thread": "multi",
        "kernelIrqchip": "split",
        "kernelIrqchipFlag": "-machine kernel-irqchip=split",
        "description": "KVM hardware acceleration - primary for Linux hosts",
        "hostSupport": "Linux 6.11+ with /dev/kvm",
        "permissions": "kvm group, 0666 on /dev/kvm",
        "nestedVirtualization": true,
        "dirtyRingSize": 65536,
        "dirtyRingFlag": "-accel kvm,dirty-ring-size=65536",
        "ept": true,
        "vpid": true,
        "unrestrictedGuest": true,
        "iommufd": {
          "enabled": true,
          "type": "iommufd",
          "flag": "-object iommufd,id=iommufd0",
          "deviceFlag": "-device vfio-pci,host=0000:01:00.0,iommufd=iommufd0",
          "description": "IOMMUFD backend for secure VFIO passthrough - replaces legacy vfio container",
          "kernelRequirement": "Linux 6.9+",
          "libvirtSupport": "12.5.0+"
        }
      },
      "hvf": {
        "enabled": true,
        "type": "hvf",
        "flag": "-accel hvf",
        "description": "Hypervisor.Framework acceleration for macOS hosts",
        "hostSupport": "macOS 14.0+ Sonoma, macOS 15.0+ Sequoia",
        "thread": "multi",
        "nestedVirtualization": false,
        "platform": "darwin-arm64, darwin-x64"
      },
      "tcg": {
        "enabled": true,
        "type": "tcg",
        "flag": "-accel tcg,thread=multi",
        "thread": "multi",
        "description": "Tiny Code Generator - fallback software emulation",
        "threadMax": 8,
        "tbSize": 1536,
        "tbSizeFlag": "-accel tcg,tb-size=1536"
      },
      "v5Accel": {
        "type": "kvm:nitro",
        "primary": "kvm",
        "secondary": "nitro",
        "nitroTrust": true,
        "description": "KVM with Nitro Enclaves Trust extension",
        "options": "kvm:nitro-trust=on,split-irqchip=on",
        "kvmVersion": "kvm-7.1.9",
        "supported": [
          "kvm",
          "kvm:nitro",
          "tcg",
          "hvf"
        ]
      }
    },
    "machine": {
      "type": "q35-9.1",
      "flag": "-machine q35-9.1,kernel-irqchip=split,smm=on,vmport=off,i8042=off",
