        "pythonVersion": "3.13.5",
        "dockerVersion": "27.3.1",
        "qemuVersion": "9.1.2",
        "ffmpegVersion": "7.1.1",
        "nativeNode": [
          "node:fs",
          "node:path",
          "node:crypto",
          "node:http",
