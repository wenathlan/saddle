  "validationRules": [
    {
      "rule": "vm profile vcpus must be in modularity_ranges.vcpu.presets",
      "error": "VHE_VCPU_RANGE"
    },
    {
      "rule": "vm profile ram_gb <= boards.json max_memory for the cpu identity socket (virtual identity display value may differ from backing memory)",
      "error": "VHE_RAM_CAP"
    },
    {
      "rule": "vm profile gpu vram must match gpu.json: full-card values or a MIG slice of the declared card",
      "error": "VHE_VRAM_PROFILE"
    },
    {
      "rule": "cpu identity family flags must match target tool expectations (zen5 => avx512f/bw/cd/dq/vl/bf16/fp16 + sha_ni; arrow_lake => avx2, no avx512)",
      "error": "VHE_CPUID_MISMATCH"
    },
    {
      "rule": "-cpu host is rejected unless /dev/kvm exists (passage.json kvm check)",
      "error": "VHE_KVM_REQUIRED"
    },
    {
      "rule": "-icount may not be combined with thread=multi performance profiles (mttcg.json)",
      "error": "VHE_ICOUNT_CONFLICT"
    },
    {
      "rule": "AI profiles must ship --shm-size>=2g (docker.json shm_size evidence)",
      "error": "VHE_SHM_REQUIRED"
    },
    {
      "rule": "LP_NUM_THREADS values above 32 clamp to 32 (mesa.json LP_MAX_THREADS)",
      "error": "VHE_MESA_THREADS_CLAMP"
    },
    {
      "rule": "SMT identities: threads = cores*2, except core-ultra-9-285k where threads = cores",
      "error": "VHE_SMT_MATH"
    },
    {
      "rule": "all spec files must carry meta.version == engine.version == 5.0.0 and meta.date == 2026-08-22",
      "error": "VHE_SPEC_DRIFT"
    }
  ],
