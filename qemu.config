        "bandwidth": "128GB/s bidirectional",
        "maxPayload": 512,
        "extendedTag": true,
        "atomics": true,
        "aer": true,
        "acs": true,
        "barType": "64-bit",
        "barRealloc": "on",
        "xPciMmio64Mb": 65536,
