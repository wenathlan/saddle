        "secureBoot": true,
        "smmRequired": true,
        "firmwareType": "edk2",
        "driveCodeFlag": "-drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd",
        "driveVarsFlag": "-drive if=pflash,format=raw,file=OVMF_VARS.fd",
