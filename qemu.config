    "spoofing": {
      "memoverlay": {
        "technique": "LD_PRELOAD",
        "library": "/usr/local/lib/libvirtualhardware.so",
        "intercept": [
          "/proc/meminfo",
          "/proc/cpuinfo"
        ],
        "scaledCopy": true,
        "env": "FAKEMEM_MEM=16G",
        "note": "copy real /proc/meminfo and scale MemTotal by factor"
      },
      "dolos": {
        "cpuinfoBindMount": "/proc/cpuinfo -> /tmp/virtual_cpuinfo",
        "sysinfoHook": "sysinfo() returns 128GB totalram",
        "ldPreload": true
      },
      "virtualNvidiaSmi": {
        "binary": "/usr/local/bin/nvidia-smi",
        "pythonMock": true,
        "multiGpu": true,
        "profiles": [
          {
            "name": "H100 80GB",
            "memory": "81559MiB",
            "tdp": "700W"
          },
          {
            "name": "A100 40GB",
            "memory": "40536MiB",
            "tdp": "400W"
          },
          {
            "name": "RTX 5090",
            "memory": "32768MiB",
            "tdp": "600W"
          }
        ]
      }
    },
    "mttcg": {
      "identity": "QEMU Multi-Threaded TCG - one vCPU thread under TCG (NOT the multi-tenant MTTG concept, which lives in mttg.config)",
      "accelFlags": [
        "--accel tcg,thread=multi",
        "-accel tcg,thread=multi,split-wx=on"
      ],
      "nestedReference": {
        "queues": "2*vCPU",
        "cflags": "-DTARGET_SUPPORTS_MTTCG",
        "threads": "1 host thread per vCPU"
      },
      "fullSpecRef": "mttg.config#mttcg (mttcg.json v5 + nested_mttcg.json merged there)",
      "tbSizeDefaultMib": 1024
    },
    "libvirtOverlay": {
      "source": "/etc/libvirt/qemu.conf.d/aetherforge.conf (pool:qemu.conf [AetherForge])",
      "header": [
        "/etc/libvirt/qemu.conf overlay for AetherForge",
        "QEMU 11.1.0 (11 Aug 2026) / 10.0.12 stable.",
        "Drop-in: copy to /etc/libvirt/qemu.conf.d/aetherforge.conf"
      ],
      "settings": {
        "user": "qemu",
        "group": "qemu",
        "dynamicOwnership": 1,
        "hugetlbfsMount": "/dev/hugepages",
        "clearEmulatorCapabilities": 0,
        "seccompSandbox": 1,
        "maxProcesses": 0,
        "maxFiles": 32768,
        "vncTls": 0,
        "spiceTls": 0,
        "rememberOwner": 1,
        "setProcessName": 1,
        "stdioHandler": "logd",
        "migrationAddress": "0.0.0.0",
        "migrationPortMin": 49152,
        "migrationPortMax": 49215
      },
      "cgroupControllers": [
        "cpu",
        "cpuset",
        "memory",
        "io",
        "pids"
      ],
      "cgroupDeviceAcl": [
        "/dev/null",
        "/dev/full",
        "/dev/zero",
        "/dev/random",
        "/dev/urandom",
        "/dev/ptmx",
        "/dev/kvm",
        "/dev/kqemu",
        "/dev/rtc",
        "/dev/hpet",
        "/dev/vfio/vfio",
        "/dev/vfio/1",
        "/dev/shm/looking-glass",
        "/dev/net/tun"
      ],
      "nvram": [
        "/usr/share/edk2/x64/OVMF_CODE.fd:/usr/share/edk2/x64/OVMF_VARS.fd",
        "/usr/share/OVMF/OVMF_CODE_4M.fd:/usr/share/OVMF/OVMF_VARS_4M.fd"
      ],
      "namespaces": [
        "mount",
        "uts",
        "ipc",
        "pid",
        "net"
      ]
    }
  }
}