          "docker/setup-buildx-action@v3.7.1",
          "docker/build-push-action@v6.10.0"
        ]
      }
    },
    "resources": {
      "minVcpu": 1,
      "maxVcpu": 1024,
      "minRamMb": 512,
      "maxRamMb": 2097152,
      "minVramMb": 1024,
      "maxVramMb": 196608,
      "unitCpu": "vCPU",
      "unitRam": "MB",
      "unitVram": "MB",
      "allocator": "vcpus.json + vram.json + gpus.json + boards.json",
      "overcommitCpu": 1.25,
      "overcommitRam": 1.1,
      "isolation": "cgroupv2 + qemu cpuset + nvidia vgpu time-sliced",
      "enforcement": "strict",
      "profiles": {
        "tiny": {
          "vcpus": 1,
          "ramMb": 512,
          "vramMb": 1024,
          "useCase": "edge preview, healthcheck, thumbnail",
          "qos": "bronze",
          "schedulingClass": "best-effort",
          "ffmpegThreads": 1,
          "notes": "minimal viable transcode, h264 baseline only"
        },
        "oddprime": {
          "vcpus": 37,
          "ramMb": 7919,
          "vramMb": 7183,
          "useCase": "prime stride validation, anti-alias cache test, jitter injection",
          "qos": "silver+prime",
          "schedulingClass": "latency-sensitive",
          "ffmpegThreads": 37,
          "isPrimeValidated": true,
          "primePurpose": "memory fragmentation and NUMA distribution resilience"
        },
        "creator": {
          "vcpus": 32,
          "ramMb": 65536,
          "vramMb": 23552,
          "useCase": "creator 4k av1 rtx 5090, davinci, premiere, blender",
          "qos": "gold",
          "schedulingClass": "realtime",
          "ffmpegThreads": 32,
          "gpuProfile": "rtx5090 creator",
          "referenceHardware": "nvidia blackwell rtx 5090 24GB"
        },
        "ml": {
          "vcpus": 192,
          "ramMb": 262144,
          "vramMb": 98304,
          "useCase": "svt-av1 2.3 two-pass, vvc research, stable diffusion video + transcode fused",
          "qos": "gold+ml",
          "schedulingClass": "gpu-bound",
          "ffmpegThreads": 96,
          "gpuProfile": "4x pro 6000 96GB or 2x b200 192GB split",
          "nvlinkRequired": true
        },
        "hyperscale": {
          "vcpus": 1024,
          "ramMb": 2097152,
          "vramMb": 196608,
          "useCase": "film8k mezzanine 96GB PRO 6000, hyperscale batch",
          "qos": "platinum-dedicated",
          "schedulingClass": "dedicated-node",
          "ffmpegThreads": 512,
          "gpuProfile": "2x pro 6000 workstation 96GB unified OR 1x gb200 superchip 192GB+64k",
          "maxTenants": 1
        }
      }
    },
    "cgroups": {
      "version": "v2",
      "mount": "/sys/fs/cgroup",
      "mountOptions": "cgroup2",
      "unified": true,
      "controllers": [
        "cpu",
        "cpuset",
        "memory",
        "io",
        "pids",
        "hugetlb",
        "rdma"
      ],
      "controllersAvailable": "cat /sys/fs/cgroup/cgroup.controllers",
      "controllersEnabled": "cpu cpuset memory io pids",
      "rootPath": "/sys/fs/cgroup",
      "omniSlice": "/sys/fs/cgroup/omni.slice",
      "vmPathTemplate": "/sys/fs/cgroup/omni.slice/{vm_id}",
      "systemdIntegration": true,
      "systemdDriver": "systemd",
      "systemdSlice": "omni.slice",
      "cpu": {
        "weight": {
          "description": "CPU weight - proportional share 1-10000, default 100",
          "file": "cpu.weight",
          "min": 1,
          "max": 10000,
          "default": 100,
          "range": "1-10000",
          "type": "weight",
          "example": "echo 5000 > /sys/fs/cgroup/omni.slice/vm-001/cpu.weight"
        },
        "max": {
          "description": "cpu.max quota period burst - hard limit quota per period microsec",
          "file": "cpu.max",
          "format": "$MAX $PERIOD",
          "formatBurst": "$MAX $PERIOD with burst",
          "quota": {
            "description": "quota in microseconds - max time cgroup can be scheduled per period",
            "default": "max",
            "unit": "usec",
            "example": "1600000 100000 = 16 CPUs max"
          },
          "period": {
            "description": "period in microseconds",
            "min": 1000,
            "max": 1000000,
            "default": 100000,
            "unit": "usec"
          },
          "burst": {
            "description": "burst - ability to burst beyond quota for short time (kernel 6.12+)",
            "min": 0,
            "default": 0,
            "unit": "usec",
            "kernelSupport": "6.2+",
            "example": "1600000 100000 burst 320000",
            "since": "kernel 6.2 cgroup v2 cpu burst"
          },
          "example": "echo '1600000 100000' > cpu.max"
        },
        "weightNice": {
          "description": "cpu.weight.nice - nice value based weight -20 to 19",
          "file": "cpu.weight.nice",
          "min": -20,
          "max": 19,
          "default": 0
        },
        "idle": {
          "description": "cpu.idle - if 1, cgroup only runs when no other cgroup is runnable",
          "file": "cpu.idle",
          "default": 0,
          "qos": "idle"
        },
        "stat": {
          "file": "cpu.stat",
          "fields": [
            "usage_usec",
            "user_usec",
            "system_usec",
            "nr_periods",
            "nr_throttled",
            "throttled_usec",
            "nr_bursts",
            "burst_usec"
          ]
        }
      },
      "cpuset": {
        "description": "cpuset - pin cgroup to specific CPUs and memory nodes",
        "files": {
          "cpus": "cpuset.cpus",
          "mems": "cpuset.mems",
          "effectiveCpus": "cpuset.cpus.effective",
          "effectiveMems": "cpuset.mems.effective"
        },
        "cpus": {
          "description": "cpuset.cpus - list of CPUs allowed",
          "example": "0-15 or 0,2,4-7",
          "file": "cpuset.cpus",
          "effectiveFile": "cpuset.cpus.effective"
        },
        "mems": {
          "description": "cpuset.mems - list of memory nodes allowed",
          "example": "0 or 0-1",
          "file": "cpuset.mems"
        },
        "exclusive": true,
        "example": "echo '0-15' > cpuset.cpus && echo '0' > cpuset.mems"
      },
      "memory": {
        "description": "memory controller - high and max limits",
        "files": {
          "high": "memory.high",
          "max": "memory.max",
          "swapMax": "memory.swap.max",
          "current": "memory.current",
          "events": "memory.events"
        },
        "high": {
          "description": "memory.high - soft limit, throttling and reclaim starts above high",
          "file": "memory.high",
          "type": "bytes",
          "default": "max",
          "example": "60G",
          "behavior": "throttle allocations, reclaim aggressively"
        },
        "max": {
          "description": "memory.max - hard limit, OOM if exceeded above max",
          "file": "memory.max",
          "type": "bytes",
          "default": "max",
          "example": "64G",
          "behavior": "OOM kill or allocation failure"
        },
        "swapMax": {
          "description": "memory.swap.max - swap limit",
          "file": "memory.swap.max",
          "default": "max",
          "example": "0 disables swap"
        },
        "low": {
          "description": "memory.low - protection low limit",
          "file": "memory.low"
        },
        "min": {
          "description": "memory.min - hard protection",
          "file": "memory.min"
        }
      },
      "io": {
        "description": "io controller - block IO weight and max",
        "files": {
          "weight": "io.weight",
          "max": "io.max",
          "stat": "io.stat",
          "bfqWeight": "io.bfq.weight (BFQ)"
        },
        "weight": {
          "description": "io.weight - proportional IO weight 1-10000",
          "file": "io.weight",
          "min": 1,
          "max": 10000,
          "default": 100
        },
        "max": {
          "description": "io.max - absolute IO max rbps wbps riops wiops per device",
          "file": "io.max",
          "example": "254:0 rbps=1073741824 wbps=1073741824",
          "format": "major:minor rbps=N wbps=N riops=N wiops=N"
        },
        "bfqWeight": {
          "description": "BFQ scheduler weight when using BFQ",
          "file": "io.bfq.weight",
          "min": 1,
          "max": 10000
        }
      },
      "pids": {
        "description": "pids controller - limit number of processes",
        "file": "pids.max",
        "current": "pids.current",
        "events": "pids.events",
        "default": "max",
        "example": "4096",
        "maxLimit": "4194304"
      },
      "hugetlb": {
        "description": "hugetlb controller - hugepages accounting",
        "enabled": true,
        "files": [
          "hugetlb.1GB.current",
          "hugetlb.1GB.max"
        ]
      }
    },
    "cgroupVmRuntime": {
      "engine": "mttg",
      "version": "5.0.0",
      "cgroupVersion": "v2",
      "cgroupPath": "/sys/fs/cgroup/omni.slice/omni-vm-prod-001",
      "cpuWeightMin": 1,
      "cpuWeightMax": 10000,
      "cpuWeightDefault": 100,
      "cpuMaxQuota": "max",
      "cpuMaxPeriod": 100000,
      "cpuMaxBurst": 0,
      "cpuset": "0-15",
      "cpusetMems": "0",
      "memoryHigh": "60G",
      "memoryMax": "64G",
      "memorySwapMax": "0",
      "ioWeight": 100,
      "ioMax": "rbps=1073741824 wbps=1073741824 rbps=1000 wiops=1000",
      "pidsMax": 4096,
      "numaBalancing": true,
      "scheduler": "EEVDF",
      "schedulerVersion": "kernel-7.1.9-eevdf",
      "schedulerAlt": [
        "BORE-6.12.15",
        "sched_ext-bp-1.2.0"
      ],
      "qosClassesList": [
        "guaranteed",
        "burstable",
        "besteffort",
        "idle"
      ],
      "tenants": {
        "gold": {
          "weight": 10000,
          "cpuMax": "1600000 100000",
          "memoryHigh": "60G",
          "memoryMax": "64G",
          "ioWeight": 1000,
          "pidsMax": 8192,
          "qos": "guaranteed",
          "cpuset": "0-15"
        },
        "silver": {
          "weight": 5000,
          "cpuMax": "800000 100000",
          "memoryHigh": "30G",
          "memoryMax": "32G",
          "ioWeight": 500,
          "pidsMax": 4096,
          "qos": "burstable",
          "cpuset": "0-7"
        },
        "bronze": {
          "weight": 100,
          "cpuMax": "200000 100000",
          "memoryHigh": "8G",
          "memoryMax": "16G",
          "ioWeight": 100,
          "pidsMax": 1024,
          "qos": "besteffort",
          "cpuset": "0-3"
        }
      },
      "qosClasses": {
        "guaranteed": {
          "cpuWeight": 10000,
          "cpuGuarantee": "100%",
          "memoryPolicy": "no-overcommit",
          "ioPolicy": "high-priority",
          "description": "Guaranteed QoS: full CPU reservation, no memory overcommit, high-priority IO"
        },
        "burstable": {
          "cpuWeight": 5000,
          "cpuGuarantee": "50%",
          "memoryPolicy": "bounded-overcommit",
          "ioPolicy": "normal",
          "description": "Burstable: baseline 50% CPU with burst to 100%, bounded memory overcommit"
        },
        "besteffort": {
          "cpuWeight": 100,
          "cpuGuarantee": "0%",
          "memoryPolicy": "overcommit",
          "ioPolicy": "low-priority",
          "description": "Best-effort: opportunistic scheduling, full overcommit allowed"
        },
        "idle": {
          "cpuWeight": 1,
          "cpuGuarantee": "0%",
          "memoryPolicy": "reclaim-first",
          "ioPolicy": "idle",
          "description": "Idle: lowest priority, first to be reclaimed under pressure"
        }
      }
    },
    "systemd": {
      "slice": "omni.slice",
      "sliceFile": "/etc/systemd/system/omni.slice",
      "description": "saddle root slice for all VMs",
      "exampleSlice": "[Unit]\nDescription=saddle Root Slice\nBefore=slices.target\n[Slice]\nCPUAccounting=yes\nMemoryAccounting=yes\nIOAccounting=yes\nTasksAccounting=yes",
      "controllerDelegation": "Delegate=cpu cpuset memory io pids"
    },
    "scheduler": {
      "default": "EEVDF",
      "description": "CPU Scheduler - EEVDF is default since kernel 6.6, with BORE and sched_ext alternatives",
      "schedulers": [
        {
          "name": "EEVDF",
          "fullName": "Earliest Eligible Virtual Deadline First",
          "since": "kernel 6.6",
          "status": "default since kernel 6.6",
          "version": "kernel-7.1.9-eevdf",
          "description": "Fair scheduling with proportional weight, replaces CFS 6.6+",
          "cgroupInterface": "cpu.weight 1-10000",
          "features": [
            "lag-based",
            "virtual deadline",
            "proportional fairness"
          ],
          "tuning": {
            "sysctl": [
              "kernel.sched_bore=0",
              "kernel.sched_min_granularity_ns=4000000"
            ]
          }
        },
        {
          "name": "BORE",
          "fullName": "Burst-Oriented Response Enhancer",
          "version": "BORE-6.12.15",
          "since": "kernel 6.8 custom patch",
          "status": "alternative patch",
          "description": "BORE scheduler patch - burst-oriented, reduces latency for interactive workloads",
          "patchUrl": "https://github.com/firelzrd/bore-scheduler",
          "features": [
            "burst-awareness",
            "interactive priority",
            "low latency"
          ],
          "binary": "kernel with BORE patch"
        },
        {
          "name": "sched_ext",
          "fullName": "Extensible Scheduler (eBPF Schedulers)",
          "version": "sched_ext-bp-1.2.0",
          "since": "kernel 6.12",
          "status": "stable in 6.12+",
          "description": "eBPF based extensible scheduler - load custom BPF scheduler programs",
          "tools": {
            "scxSimple": "Simple scheduler",
            "scxBpfland": "Userland-inspired scheduler",
            "scxRusty": "Rust scheduler",
            "scxCentral": "Central scheduler"
          },
          "bpfProgramsPath": "/usr/share/sched_ext/",
          "loadCommand": "scx_simple or scx_bpfland",
          "kernelConfig": "CONFIG_SCHED_EXT=y",
          "libbpf": "1.6.0",
          "features": [
            "BPF schedulers",
            "user-defined policies",
            "hot-reload"
          ]
        }
      ],
      "numa": {
        "balancing": true,
        "description": "NUMA balancing via kernel",
        "sysctl": "kernel.numa_balancing=1",
        "scanPeriod": "kernel.numa_balancing_scan_period_ms=1000",
        "options": [
          "numa_balancing=1 enables automatic NUMA placement"
        ]
      }
    },
