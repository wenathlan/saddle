    "base": {
      "binary": "qemu-system-x86_64",
      "binaryVersion": "11.1.0",
      "display": "none",
      "daemonize": false,
      "sdl": false,
      "gtk": false,
      "vnc": "off",
      "monitor": "none",
      "serial": "null",
      "parallel": "none",
      "name": "saddle-v6-vm",
      "realtime": "mlock=on",
      "msg": "timestamp=on,guest-name=on",
      "objectMemoryBackend": "memory-backend-memfd",
      "nativePreference": {
        "1": "node:fs",
        "2": "node:path",
        "3": "node:crypto",
        "4": "node:http",
        "5": "node:child_process",
        "6": "node:os",
        "7": "node:process"
      }
