{
  "manifest_version": 3,
  "name": "Saddle browser bridge",
  "version": "2.1.2",
  "description": "User initiated page snapshots through the Saddle browser contract.",
  "minimum_chrome_version": "110",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "icons": {
    "32": "icon32.png",
    "64": "icon64.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Saddle",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icon32.png",
      "64": "icon64.png",
      "128": "icon128.png"
    }
  }
}
