<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <PackageId>Saddle</PackageId>
    <Version Condition="'$(PackageVersion)' == ''">2.0.6</Version>
    <Authors>wenathlan</Authors>
    <Description>Binary computing engine that turns distributed storage into a publishable working set, carrying the merged e2ugh virtual-hardware engine CLI adapter (the 2.0.0 grand merge).</Description>
    <PackageProjectUrl>https://github.com/wenathlan/saddle</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wenathlan/saddle</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>distributed-computing;virtual-memory;automation;virtual-hardware;qemu;mesa;container</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
  <ItemGroup>
    <!-- The C# process adapter of the merged engine surface: explicit local
         saddle CLI invocations, no shell, no credentials, no host hardware. -->
    <Compile Include="SaddleCli.cs" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
