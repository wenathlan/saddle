          "numaFlag": "-numa node,nodeid=0,memdev=ram0",
          "fullCli": "qemu-system-x86_64 -machine q35-9.1,kernel-irqchip=split -accel kvm,thread=multi -cpu host -smp cpus=1,cores=1 -m 512 -object memory-backend-memfd,id=ram0,size=512M,share=on -numa node,memdev=ram0 -drive if=pflash,format=raw,readonly=on,file=/usr/share/OVMF/OVMF_CODE_4M.secboot.fd -drive if=pflash,format=raw,file=OVMF_VARS.fd -nographic -serial null"
