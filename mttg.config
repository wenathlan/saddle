    "pipeline": {
      "description": "The 24-stage GPU-accelerated transcode pipeline of the pool pipelinememorypassage family. The stages are media/transcode domain and live canonically in media.ts (stagecatalog + stageorderv5 for the alternate v5 ordering provenance); this section keeps only the MTTG scheduling policy that drives them.",
      "implementation": "media.ts (mediapipeline + createoptimal + buildffmpegcommand + passagesecurechannel)",
      "stageCount": 24,
      "stageNames": [
        "01_ingest_audit",
        "02_probe_ffprobe71",
        "03_tieredmemory_reserve",
        "04_hugepage_alloc_2m1g",
        "05_zram_lzorle_zstd",
        "06_cxl_map_v2_v3",
        "07_vcpu_pin_ccd_x3d",
        "08_hwaccel_detect_blackwell",
        "09_hwupload_cuda",
        "10_deinterlace_bwdif_cuda",
        "11_scale_cuda_npp",
        "12_tonemap_bt2020_cuda",
        "13_denoise_cuda",
        "14_color_mgmt",
        "15_nvenc_blackwell_encode",
        "16_qsv_fallback",
        "17_audio_transcode",
        "18_subtitle_burn",
        "19_mux_container",
        "20_passage_message_vsock",
        "21_qemu_balloon_notify",
        "22_tiered_reclaim",
        "23_mttg_slice_report",
        "24_artifact_gc_finalize"
      ],
      "stageOrderingProvenance": {
        "v6": "pipelinememorypassage.ts — memory stages 03-07 precede GPU work; CCD0 V-Cache carries the video filter chain",
        "v5": "src_pipeline_memory_passage.ts (src_mttg_pipeline) — demux/decode walk with sharpen, crop_pad, overlay_logo, thumbnail and upload_egress kept in stageorderv5"
      },
      "policy": {
        "name": "create_optimal",
        "source": "pool:src_virtualization_core.cpp EncodingOptimizationManager::create_optimal",
        "mediaTsRef": "media.ts createoptimal()",
        "encoderSelection": [
          "AV1 at width>=3840 and height>=2160 forces the Blackwell dual NVENC encoder (best AV1 quality of 2026)",
          "H264 ultra-low-latency (cbr_low_latency mode) prefers Intel QuickSync",
          "AMD hosts prefer AMF for 1080p power efficiency",
          "no hardware match falls back to software x265 4.1 + SVT-AV1 (max 32 instances)"
        ],
        "presetRecommendation": {
          "ultraLowLatency": "p1",
          "lowLatency": "p2",
          "live": "p3",
          "vodAv1": "p5",
          "vodHevc": "p6",
          "default": "p4"
        },
        "instanceRecommendation": "pixel-count throttle: base 5 (av1) / 8 (nvenc other) / 6 (qsv-amf) divided by megapixels/2, floor 1",
        "failFast": "first non-recoverable stage failure stops the walk; recoverable failures continue when mttg fail_fast=false",
        "skipRules": {
          "10DeinterlaceBwdifCuda": "skip when probe.interlaced is false",
          "12TonemapBt2020Cuda": "skip when not (probe.hdr and job.tonemap)",
          "13DenoiseCuda": "skip when mode lacks denoise/hqdn",
          "16QsvFallback": "skip when a hardware backend won the create_optimal policy",
          "18SubtitleBurn": "skip when no subtitle path"
        }
      },
      "stage20PassageContract": {
        "transport": "vsock+virtio-serial",
        "encryption": "chacha20-poly1305",
        "auth": "ed25519",
        "mtu": 65536,
        "control": "vsock://2:1024",
        "implementation": "media.ts passagesecurechannel (seal/open over the RFC 8439 AEAD of security.ts)"
      },
      "mergedFrom": [
        "pool:pipelinememorypassage.ts [S6 v6 — 24 stages + policy, UNIQUE]",
        "pool:src_pipeline_memory_passage.ts [V5 — stage ordering + skip rules]",
        "pool:src_virtualization_core.cpp [create_optimal encoder policy]"
      ]
    }
  },
  "mttcg": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "summary": {
      "what": "MTTCG runs each vCPU on its own host thread, each executing translated code from a shared translation block cache.",
      "oneLine": "1 vCPU = 1 host pthread executing TCG-translated guest code.",
      "since": "QEMU 2.8 (2016); default for supported host/guest pairs since QEMU 3.0",
      "relevance": "the entire VHE CI strategy on GitHub-hosted runners (no /dev/kvm) rests on MTTCG"
    },
    "architecture": {
      "perVcpuThread": {
        "description": "QEMU spawns one QEMUThread per vCPU; each thread runs its own TCG translator loop and executes translated host code for that vCPU.",
        "threadNaming": "vCPU threads appear as qemu-system-x86_64 processes/threads in /proc/<pid>/task; map via QMP query-cpus-fast",
        "exit": "vCPU hot-unplug parks the thread (cpu->exit_request)"
      },
      "translationBlockCache": {
        "description": "Translated guest code (TranslationBlocks) lives in one shared code buffer sized by tb-size (MiB).",
        "sizeFlag": "-accel tcg,tb-size=<MiB> (512-1024 recommended for builds)",
        "flush": "cache full triggers a full flush and retranslation - larger tb-size reduces flush frequency on big code footprints",
        "shared": "all vCPU threads share the cache; a block translated by vCPU 0 is reused by vCPU 1"
      },
      "qht": {
        "name": "QEMU Hash Table (QHT)",
        "description": "lockless (RCU-protected) hash table mapping guest PC -> TranslationBlock; readers scale without contention on the lookup fast path",
        "source": "util/qht.c in the QEMU tree"
      },
      "tbInvalidation": {
        "description": "when guest code modifies itself or memory mappings change, TBs must be invalidated across all vCPU threads; performed via RCU lists + tb_lock coordination",
        "cost": "self-modifying-code-heavy workloads (JITs inside the guest, e.g. V8/CPython JIT) suffer invalidation storms - expect lower speedups"
      },
      "memoryModelRule": {
        "description": "MTTCG is enabled only when the guest memory model is compatible with the host memory model (strongly-ordered guest on weakly-ordered host requires barriers that TCG cannot provide cheaply).",
        "x8664OnX8664": "allowed and DEFAULT",
        "aarch64OnX8664": "allowed (weak-on-strong)",
        "x8664OnAarch64": "not allowed - single-threaded TCG fallback",
        "check": "QEMU prints 'MTTCG is enabled' / uses thread=multi automatically; force with -accel tcg,thread=multi"
      }
    },
    "enablement": {
      "flagRecommended": "-accel tcg,thread=multi",
      "defaultBehavior": "thread=multi is chosen automatically for supported pairs (x86_64 guest on x86_64 host)",
      "forcesSingleThread": [
        "-icount (instruction counting / deterministic virtual time / record & replay) - MTTCG is incompatible with icount determinism",
        "cross-arch memory-model mismatch (e.g. x86_64 guest on weakly ordered ARM host)",
        "explicit -accel tcg,thread=single"
      ],
      "verifyInsideProcess": "query the accelerator with QMP query-accels or observe the count of vCPU threads: ps -T -p <qemu-pid> | grep -c qemu-system"
    },
    "scalingTo192Vcpus": {
      "epyc9965Identity": "192 vCPU VM = 192 host threads (MTTCG), plus 1 main loop thread + async worker threads (AIO, vhost, etc.)",
      "fullSmt2Identity": "384 vCPUs (EPYC 9965 with SMT2) = 384 host threads - only sensible on >= 96-core hosts",
      "oversubscriptionGuidance": [
        "vCPUs <= host logical CPUs: full parallel translation and execution",
        "2x oversubscription: acceptable for I/O-bound sandboxes (edge profiles), CPU-bound builds degrade linearly",
        ">=4x oversubscription: use it only for topology-visible spoofing (lscpu inside guest), not for throughput"
      ],
      "hostThreadPlacement": "pin vCPU threads to host cores with taskset -pc <hostcpu> <tid> or cgroup cpuset (docker.json cpuset) to avoid migration cost",
      "githubRunnerReality": "ubuntu-latest provides 4 vCPUs: profiles above 8 vCPus on hosted CI are for identity tests, not throughput (cores.json host_sizing)"
    },
    "performanceTuning": {
      "tbSize": {
        "small": "128 MiB - dev profiles, fast start",
        "medium": "512 MiB - build profiles",
        "large": "1024 MiB - buildfarm/buildfarm-max, LLVM-class builds",
        "tradeoff": "tb-size is allocated from host RAM per VM process; 1024 MiB x N VMs adds up"
      },
      "avoidIcount": "never combine -icount with performance profiles; icount forces single-thread TCG and caps throughput at roughly 1/N of MTTCG on N cores",
      "jitHeavyGuests": "guest-side JITs (Node V8, PyPy, JVM) trigger TB invalidation storms; prefer running those directly in Docker (docker.json) and use QEMU only for topology/OS-level identities",
      "hostPinning": "taskset QEMU as a whole (taskset -c 0-191 qemu-system-x86_64 ...) so the scheduler cannot place 192 threads on 8 cores with cache thrash",
      "memoryBackend": "use memory-backend-ram with prealloc=on for large RAM identities to avoid zero-page faults during boot (-object memory-backend-ram,id=mem0,size=512G,prealloc=on -numa node,memdev=mem0)",
      "iothread": "add -object iothread,id=io0 and attach virtio-blk (iothread=io0) so disk I/O leaves vCPU threads free",
      "directKernelBoot": "-kernel/-initrd/-append skips firmware: seconds of boot time saved per VM (qemu.json microvm recipe)"
    },
    "benchmarksReference": {
      "methodology": "relative numbers; absolute speed depends on host and workload mix",
      "observations": [
        {
          "workload": "guest kernel/LLVM build",
          "mttcgVsStcg": "near-linear scaling up to host core count (e.g. 8 vCPUs on 8 host cores approx 7x vs thread=single)"
        },
        {
          "workload": "I/O-bound sandbox (npm install, API calls)",
          "mttcgVsStcg": "2-4x (bottleneck is slirp + disk, not translation)"
        },
        {
          "workload": "single-threaded guest program",
          "mttcgVsStcg": "1x (one vCPU active; MTTCG adds nothing)"
        },
        {
          "workload": "guest-side JIT compilation",
          "mttcgVsStcg": "1.5-3x (TB invalidation limits scaling)"
        }
      ],
      "kvmReferencePoint": "KVM is 10-30x faster than MTTCG for CPU-bound guests; MTTCG at 192 vCPUs on matching hardware reaches only a fraction of native speed - plan CI timeouts accordingly (vm.config.json lifecycle.timeout_s)",
      "microvmBoot": "microvm machine + TCG boots ~4x faster than default PC machine; still ~3x slower than Firecracker (which requires KVM)"
    },
    "limitations": [
      "x86_64 guest on x86_64 host: MTTCG OK (VHE case)",
      "cross-arch guests (e.g. running aarch64 guest on x86_64 host) fall back to single-threaded TCG where the memory model requires it",
      "-icount and record/replay force thread=single",
      "TB invalidation storms from guest self-modifying code (JITs) erode scaling",
      "MTTCG performance never approaches KVM; it is a portability tool, not a performance tool",
      "192 vCPU identities spawn 192 host threads - check RLIMIT_NPROC and cgroup pids.max on CI hosts (docker.json pids-limit)"
    ],
    "recommendedFlagsMatrix": {
      "dev": "-accel tcg,thread=multi,tb-size=128",
      "build": "-accel tcg,thread=multi,tb-size=512",
      "buildfarm": "-accel tcg,thread=multi,tb-size=1024",
      "buildfarmMax": "-accel tcg,thread=multi,tb-size=1024 (+ host pinning, prealloc memory backend, iothread for virtio-blk)",
      "edge": "-accel tcg,thread=multi -machine microvm -kernel ... (boot latency first)",
      "selfHostedKvm": "-accel kvm -cpu host (MTTCG not used; keep tcg fallback configured)"
    },
    "relatedModules": {
      "qemu.json": "accelerator flags, tb-size guidance, EPYC-v5 model, QMP lifecycle",
      "cores.json": "vCPU presets -> -smp topology and host thread counts",
      "passage.json": "KVM availability ladder and CI fallback policy",
      "vm.config.json": "per-profile accel field (preferred kvm / fallback tcg,thread=multi)"
    },
    "sourceRefs": {
      "file": "tcg-accel-ops-mttcg.c",
      "functions": [
        "qemu_thread_create",
        "mttcg_qemu_thread_new",
        "tcg_register_thread"
      ],
      "queues": "2 * vCPU count",
      "performance": {
        "scaling": "near-linear up to 192 vCPUs",
        "overhead": "<8%"
      },
      "compat": {
        "requires": "TCG",
        "notWith": "KVM",
        "host": "any"
      },
      "qemuArgs": "--accel tcg,thread=multi",
      "targetSupportsMttcg": true,
      "fullConfigRef": "qemu.config#mttcg (accel flags)"
    }
  }
}