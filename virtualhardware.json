  "modularityRanges": {
    "vcpu": {
      "min": 1,
      "max": 192,
      "default": 4,
      "presets": [1, 2, 4, 8, 16, 32, 64, 96, 128, 192],
      "smt2ThreadMax": 384,
      "source": "cores.json vcpu_presets (EPYC 9965 identity ceiling)"
    },
    "ramGb": {
      "min": 1,
      "max": 1024,
      "default": 8,
      "notes": [
        "1-2 GB edge sandboxes",
        "512 GB buildfarm-max",
        "1024 GB ai-cluster (DGX-class node identity)",
        "virtual identity display values can exceed physical via --memory-swap=-1 + overcommit (docker.json)"
      ],
      "boardCaps": {
        "sp5DualSocket": 12288,
        "sp5Single": 6144,
        "str5Wrx90": 2048,
        "str5Trx50": 1024,
        "am5": 192,
        "lga1851": 192
      }
    },
    "vramGb": {
      "min": 8,
      "max": 96,
      "default": 0,
      "migSlices": [24, 48, 96],
      "gpuFull": [16, 32, 80, 96, 192, 288],
      "notes": [
        "8-96 GB is the MIG-slice envelope (1g.24gb..4g.96gb on RTX PRO 6000 Server)",
        "full-GPU identities go up to 288 GB (MI350X) / 1536 GB aggregate (8x B200)",
        "see gpu.json mig and vm.config.json profile_index.mig_vram_slices_gb"
      ]
    },
    "diskGb": {
      "min": 4,
      "max": 1024,
      "default": 32
    },
    "network": {
      "modes": ["user (slirp)", "tap (root)", "vfio SR-IOV VF"],
      "default": "user"
    }
  },
  "defaults": {
    "vmProfile": "dev",
    "cpuIdentity": "core-ultra-9-285k",
