{
	"$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100,
		"lineEnding": "lf",
		"formatWithErrors": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"a11y": {
				"noStaticElementInteractions": "off",
				"useKeyWithClickEvents": "off",
				"useSemanticElements": "off"
			},
			"correctness": {
				"useExhaustiveDependencies": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useNodejsImportProtocol": "off",
				"useConst": "error"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noEmptyBlock": "warn"
			},
			"complexity": {
				"noUselessFragments": "warn",
				"noForEach": "off"
			},
			"performance": {
				"noDelete": "off"
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "es5",
			"arrowParentheses": "always"
		}
	},
	"css": {
		"parser": {
			"cssModules": true,
			"allowWrongLineComments": true
		},
		"formatter": {
			"enabled": true
		}
	},
	"files": {
		"includes": ["*.ts", "web/**", "tests/**"],
		"ignore": ["node_modules", "dist", "*.min.*"],
		"ignoreUnknown": true
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	}
}
