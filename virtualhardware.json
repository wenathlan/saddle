  "resolutionOrder": [
    "1. orchestrator loads virtualhardware.json defaults",
    "2. vm.config.json profile selected (id)",
    "3. cpu.json identity bound (flags, clocks, caches) + cores.json preset (vcpus, smp)",
    "4. boards.json platform checked (memory cap, PCIe lanes, machine type)",
