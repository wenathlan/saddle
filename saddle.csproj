<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <PackageId>Saddle</PackageId>
    <Version Condition="'$(PackageVersion)' == ''">2.0.0</Version>
    <Authors>wenathlan</Authors>
    <Description>Binary computing engine that turns distributed storage into a publishable working set.</Description>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/wenathlan/saddle</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>distributed-computing;virtual-memory;automation</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>
</Project>
