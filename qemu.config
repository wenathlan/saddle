        "libvirtNvramTemplate": "/usr/share/OVMF/OVMF_VARS.fd"
      },
      "v5Machine": {
        "type": "q35",
        "version": "q35-9.2",
        "default": "q35",
        "options": "smm=on,accel=kvm,kernel-irqchip=split",
        "supported": [
